PORT=8080
BASE_URL=http://localhost:8080

# Number of proxies in front of the app (leave unset when running locally).
TRUST_PROXY=1

# Creating links: burst size, then a steady rate per minute.
RATE_LIMIT_CREATE_BURST=20
RATE_LIMIT_CREATE_PER_MIN=10

# Following links.
RATE_LIMIT_REDIRECT_BURST=120
RATE_LIMIT_REDIRECT_PER_MIN=600
